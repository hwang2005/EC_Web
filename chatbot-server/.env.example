# Ollama must be running locally and the model must be installed first:
#   ollama serve
#   ollama pull llama3

OLLAMA_BASE_URL=http://localhost:11436
OLLAMA_MODELS=YOUR DIRECTORY FOR OLLAMA MODELS
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EMBED_TIMEOUT_SECONDS=300
